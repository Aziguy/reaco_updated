DEBUG=true
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

DATABASE_URL=postgres://comegusto:comegusto@localhost:5432/comegusto
REDIS_URL=

# Emails: see docs/CONFIGURATION.md (e.g. smtp+tls://login%40smtp-brevo.com:key@smtp-relay.brevo.com:587)
EMAIL_URL=consolemail://
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Comégusto <contact@comegusto.local>
CONTACT_EMAIL=contact@comegusto.local
ACCOUNT_EMAIL_VERIFICATION=optional
ADMINS=

# Redirect URI: https://DOMAIN/compte/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

IMPACT_CO2_API_KEY=
PRICE_COUNTRIES=FR
PRICE_HISTORY_DAYS=365
LOG_LEVEL=INFO

# Production (docker-compose.prod.yml)
DOMAIN=
POSTGRES_PASSWORD=
ADMIN_URL=admin/

# Media on S3-compatible storage (Cloudflare R2, Scaleway, Backblaze B2, AWS S3)
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=
